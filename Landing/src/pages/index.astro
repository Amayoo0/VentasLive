---
import ContactForm from "@/components/ContactForm";
import Header from "../components/Header.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Landing — Esqueleto</title>
	</head>
	<body>
		<Header />

		<main class="bg-gray-50">
			<section id="hero" aria-labelledby="hero-title" class="py-20">
				<div class="container mx-auto px-4 text-center">
					<h1 id="hero-title" class="text-4xl font-bold mb-4">Inicio</h1>
					<p class="mt-4 text-lg text-gray-700">
						Esta es una landing page de ejemplo. Aquí puedes añadir información sobre tu producto o servicio.
					</p>
				</div>
			</section>

			<section id="projects" aria-labelledby="features-title" class="py-20 bg-white">
				<div class="container mx-auto px-4">
					<h2 id="projects-title" class="text-3xl font-semibold mb-6">Proyectos</h2>
					<p class="mt-4 text-lg text-gray-700">
						Aquí puedes mostrar algunos de tus proyectos destacados. Utiliza tarjetas o listas para presentar la información de manera clara.
					</p>
				</div>
			</section>

			<section id="contact" aria-labelledby="contact-title" class="py-20 bg-gray-100">
				<div class="container mx-auto px-4">
					<h2 id="contact-title" class="text-3xl font-semibold mb-6">Contacto</h2>
					<ContactForm client:load />
				</div>
			</section>
		</main>
	</body>
</html>
